// Função para alternar entre as páginas do site sem recarregar (evita erros 404)
function abrirPagina(idPagina) {
    const paginas = document.querySelectorAll('.conteudo-pagina');
    paginas.forEach(p => p.classList.remove('ativo'));

    const botoes = document.querySelectorAll('nav button');
    botoes.forEach(b => b.classList.remove('ativo'));

    const paginaAlvo = document.getElementById(idPagina);
    if (paginaAlvo) {
        paginaAlvo.classList.add('ativo');
    }
    
    // Ativa o botão correspondente no menu
    if(idPagina === 'pagina-inicio') document.getElementById('btn-inicio').classList.add('ativo');
    if(idPagina === 'pagina-quem-somos') document.getElementById('btn-quem-somos').classList.add('ativo');
    if(idPagina === 'pagina-cultos') document.getElementById('btn-cultos').classList.add('ativo');
    if(idPagina === 'pagina-aulas') document.getElementById('btn-aulas').classList.add('ativo');
    if(idPagina === 'pagina-contatos') document.getElementById('btn-contatos').classList.add('ativo');
}

